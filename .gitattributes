# Normalise line endings so the repo behaves the same on Windows, macOS and Linux
* text=auto
*.py   text eol=lf
*.sql  text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf
# CSVs are written with a UTF-8 BOM + CRLF on purpose (Excel on Windows); git must not touch their bytes
*.csv  -text
*.png  binary
*.jpg  binary
*.jpeg binary
*.joblib binary
